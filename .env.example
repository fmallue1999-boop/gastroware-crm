# Variables de entorno de GastroWare CRM.
# Copiar a .env.local para correr en local; en producción se cargan en
# Vercel → Settings → Environment Variables (y después Redeploy).
# Las que empiezan con NEXT_PUBLIC_ llegan al navegador; el resto solo al servidor.

# --- Supabase (Settings → API) ---
# URL del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública (anon / publishable): la usa el navegador y el login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role / secret): SOLO servidor. La usan los crons,
# el webhook de WhatsApp, la baja de emails y las subidas firmadas. Sin espacios.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL pública de la app (links en emails y en el push). Sin barra final.
NEXT_PUBLIC_APP_URL=https://gastroware-crm.vercel.app

# --- Crons de Vercel (vercel.json) ---
# Texto largo inventado. Vercel lo manda como "Authorization: Bearer …" a
# /api/cron/recurrencias, /api/cron/resumen y /api/cron/sync-resend.
CRON_SECRET=
# Firma de los links de baja de email (/api/baja). Texto largo inventado,
# distinto de CRON_SECRET. Si falta, se usa CRON_SECRET (compatibilidad).
BAJA_SECRET=

# --- Notificaciones push (web-push) ---
# Par de claves VAPID: generar una vez con `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el protocolo VAPID (mailto: de la empresa).
VAPID_SUBJECT=mailto:info@gastroware.com.ar

# --- Email (Resend, dominio gastroware.com.ar verificado) ---
# API key "sending" creada en resend.com → API Keys.
RESEND_API_KEY=

# --- IA (asistente de mensajes, resúmenes, lectura de credenciales) ---
# Clave de console.anthropic.com. Si falta, las funciones de IA quedan apagadas.
ANTHROPIC_API_KEY=

# --- WhatsApp Business API (Meta). Opcional: sin estas, el webhook responde 503 ---
# Texto inventado que se repite en el panel de Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta: valida la firma de cada entrega.
WHATSAPP_APP_SECRET=
